config EBPFOS
	bool "eBPFOS transactional component graph"
	depends on BPF_SYSCALL && BPF_JIT
	depends on KEYS && ASYMMETRIC_KEY_TYPE
	depends on X509_CERTIFICATE_PARSER = y
	depends on SYSTEM_DATA_VERIFICATION
	select CRYPTO_LIB_SHA256
	default n
	help
	  Build the eBPFOS component nucleus and its kernel-enforced admission
	  boundary.  Admission uses a private keyring populated from exactly one
	  compile-time X.509 certificate; it never consults a caller-selected or
	  system-wide keyring.

config EBPFOS_TRUSTED_KEYS
	string "eBPFOS admission X.509 certificate"
	depends on EBPFOS
	help
	  Path to one PEM X.509 certificate.  The build converts it to
	  DER, and boot fails the admission trust setup unless the resulting
	  list contains exactly one certificate.  Do not place a private key in
	  this option or in the kernel image.

config EBPFOS_RUNTIME_ROOT
	bool "Minimal eBPFOS runtime root executor"
	depends on X86_64 && BPF_SYSCALL && BPF_JIT
	select EBPFOS_KOPERATION
	default n
	help
	  Build only the policy-free target runtime root primitive.  It holds
	  verifier-admitted/JITed component program references in an immutable
	  finite slot bundle, publishes the bundle with one expected-epoch RCU
	  pointer swap, and synchronously dispatches an opaque typed call frame.
	  Admission policy, graph construction, signatures, and role semantics
	  remain outside this target-runtime nucleus.

config EBPFOS_BUILD
	bool
	default y if EBPFOS || EBPFOS_RUNTIME_ROOT || EBPFOS_KOPERATION

config EBPFOS_KOPERATION
	bool "eBPFOS generated x86-64 KOperation executor"
	depends on X86_64 && BPF_SYSCALL && BPF_JIT
	default y if EBPFOS
	help
	  Build the generic verifier-to-native KOperation executor and its
	  generated operation table.  Individual operations are declarative data;
	  they do not add verifier hooks or native fallback implementations.  The
	  executor can be linked with the policy-free runtime root without the
	  donor admission/control plane.

config EBPFOS_KUNIT_TEST
	bool "eBPFOS component nucleus tests" if !KUNIT_ALL_TESTS
	depends on EBPFOS && KUNIT
	default KUNIT_ALL_TESTS
