config EBPFOS
	bool "eBPFOS transactional component graph"
	depends on BPF_SYSCALL && BPF_JIT
	select CRYPTO_LIB_SHA256
	select DEBUG_KERNEL
	select KALLSYMS
	select KALLSYMS_ALL
	default n
	help
	  Build the eBPFOS component nucleus and transactional package admission.
	  Keep data symbols, including local and per-CPU allocations, available
	  for native-symbol relocations at runtime.

config EBPFOS_BUILD
	bool
	default y if EBPFOS || EBPFOS_KOPERATION

config EBPFOS_KOPERATION
	bool "eBPFOS terminal-effect KOperation"
	depends on X86_64 && BPF_SYSCALL && BPF_JIT
	default y if EBPFOS
	help
	  Build the generic verifier-checked terminal-effect call. The verifier
	  validates the terminal backedge before the x86 JIT emits its effect.

config EBPFOS_ENTRY_LINK
 bool "Typed multi-target BPF entry links"
 depends on EBPFOS && X86_64 && DYNAMIC_FTRACE
 depends on !CFI
 select INSTRUCTION_DECODER
 default y
 help
   Replace reserved or inactive ftrace entries and module-local callers
   through BPF program and link objects using one text transaction.
   Native programs are source-built staged exceptions requiring CAP_SYS_ADMIN.

config EBPFOS_PTVIEW
 bool "Prototype per-mm kernel view mappings"
 depends on EBPFOS_ENTRY_LINK && X86_64 && !X86_5LEVEL
 default n
 help
   Opt-in four-level, non-PCID prototype. Private copies cover changed
   binding-data pages.
   Rule resolution retains the selected mappings at the task boundary.

config EBPFOS_AUTOBIND
 bool "Automatic rule-selected kernel mappings"
 depends on EBPFOS_PTVIEW
 default y
 help
   Resolve existing L6 rules at the task boundary and map immutable callback
   data at its original addresses. Syscall roots keep their existing table.
   The owner-boundary handoff remains an optional alternative
   when this option is disabled. Paging restrictions are those of PTVIEW.
