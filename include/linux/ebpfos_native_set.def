/* Original native bodies; this list also drives BTF contracts and compilation. */
NATIVE_FUNCTION(_copy_from_user, _copy_from_user, KF_SLEEPABLE)
NATIVE_ARG(_copy_from_user, 0, "arg:sz:2")
NATIVE_ARG(_copy_from_user, 0, "arg:nullable")
NATIVE_ARG(_copy_from_user, 0, "arg:nonnull-size")
NATIVE_ARG(_copy_from_user, 1, "arg:address")
NATIVE_POINTEE_TAG(_copy_from_user, 1, "user")

NATIVE_FUNCTION(copy_from_kernel_nofault, copy_from_kernel_nofault, 0)
NATIVE_ARG(copy_from_kernel_nofault, 0, "arg:sz:2")
NATIVE_ARG(copy_from_kernel_nofault, 0, "arg:nullable")
NATIVE_ARG(copy_from_kernel_nofault, 0, "arg:nonnull-size")
NATIVE_ARG(copy_from_kernel_nofault, 1, "arg:address")

/* This verifier checks typed struct arguments as trusted/referenced implicitly. */
NATIVE_FUNCTION(__mod_zone_page_state, __mod_zone_page_state, 0)
NATIVE_ENUM_MAX(__mod_zone_page_state, 1, zone_stat_item, NR_VM_ZONE_STAT_ITEMS)

NATIVE_FUNCTION(_prb_read_valid, _prb_read_valid, 0)
NATIVE_ARG(_prb_read_valid, 2, "arg:nullable")
NATIVE_ARG(_prb_read_valid, 3, "arg:nullable")

NATIVE_STATIC_CALL(__ebpfos_bound_apic_call_read, __SCT__apic_call_read, apic, read, 0)
/* A u32 MMIO access stays in the APIC page; native registers have a 16-byte stride. */
NATIVE_ARG(__SCT__apic_call_read, 0, "arg:max:4092")
NATIVE_ARG(__SCT__apic_call_read, 0, "arg:align:16")
NATIVE_ALIAS(__SCT__apic_call_read, __SCT__apic_call_read)
NATIVE_STATIC_CALL(__ebpfos_bound_apic_call_write, __SCT__apic_call_write, apic, write, 0)
NATIVE_ARG(__SCT__apic_call_write, 0, "arg:max:4092")
NATIVE_ARG(__SCT__apic_call_write, 0, "arg:align:16")
NATIVE_ALIAS(__SCT__apic_call_write, __SCT__apic_call_write)

/* Original selected-driver CPU IPI; its CPU index stays within the configured
 * per-CPU offset table. Online/destination and IRQ protocol remain the caller's.
 */
NATIVE_STATIC_CALL(__ebpfos_bound_apic_call_send_IPI, __SCT__apic_call_send_IPI, apic, send_IPI, KF_DESTRUCTIVE)
NATIVE_COUNT_MAX(__SCT__apic_call_send_IPI, 0, NR_CPUS)
NATIVE_ARG(__SCT__apic_call_send_IPI, 1, "arg:max:255")
NATIVE_ALIAS(__SCT__apic_call_send_IPI, __SCT__apic_call_send_IPI)

/* Calibrated original hardware-delay body; system callers remain compiled. */
NATIVE_FUNCTION(__const_udelay, __const_udelay, 0)

/* Original regular clock snapshot; the enum selects a three-entry table. */
NATIVE_FUNCTION(ktime_get_with_offset, ktime_get_with_offset, 0)
NATIVE_ENUM_MAX(ktime_get_with_offset, 0, tk_offsets, TK_OFFS_MAX)

/* Original configured CR4 read and pinned write/repair/retry algorithm.
 * Writes retain stock destructive-call permission checks; callers still owe
 * their native CPU, IRQ, preemption and TLB-shadow execution protocol.
 */
NATIVE_INLINE_FUNCTION(native_read_cr4, native_read_cr4, 0)
NATIVE_FUNCTION(native_write_cr4, native_write_cr4, KF_DESTRUCTIVE)

/* Existing .noinstr.text IRQ-flags body and its original C prototype. */
NATIVE_FUNCTION(native_save_fl, native_save_fl, 0)

/* Original safe RDMSR body, trace branch, eight-byte output and fixup status. */
NATIVE_INLINE_FUNCTION(native_read_msr_safe, native_read_msr_safe, 0)

/* APIC's original unchecked RDMSR warning/zero recovery, not safe-read status. */
NATIVE_INLINE_FUNCTION(__rdmsr, __rdmsr, 0)

/* Original CLI boundary; callers retain their CPU/IRQ execution protocol. */
NATIVE_INLINE_FUNCTION(native_irq_disable, native_irq_disable, KF_DESTRUCTIVE)
NATIVE_INLINE_FUNCTION(native_irq_enable, native_irq_enable, KF_DESTRUCTIVE)

/* Original idle envelope keeps buffer clearing and adjacent STI/HLT together. */
NATIVE_FUNCTION(default_idle, default_idle, KF_DESTRUCTIVE)

/* Original IRQ/CPU-feature envelopes keep both SWAPGS operations together. */
NATIVE_FUNCTION(x86_gsbase_read_cpu_inactive, x86_gsbase_read_cpu_inactive, 0)
NATIVE_FUNCTION(x86_gsbase_write_cpu_inactive, x86_gsbase_write_cpu_inactive, KF_DESTRUCTIVE)
/* Low canonical user addresses are valid in both four- and five-level modes. */
NATIVE_ARG(x86_gsbase_write_cpu_inactive, 0, "arg:max:140737488355327")
NATIVE_FUNCTION(current_save_fsgs, current_save_fsgs, KF_DESTRUCTIVE)

/* Keep the original boot-selected port/udelay strategy and its C ABI. */
NATIVE_FUNCTION(native_io_delay, native_io_delay, KF_DESTRUCTIVE)

/* Keep the original user-access/fault windows and length/error semantics. */
NATIVE_FUNCTION(strncpy_from_user, strncpy_from_user, KF_SLEEPABLE)
NATIVE_ARG(strncpy_from_user, 0, "arg:sz:2")
NATIVE_ARG(strncpy_from_user, 0, "arg:nullable")
NATIVE_ARG(strncpy_from_user, 0, "arg:nonnull-size")
NATIVE_ARG(strncpy_from_user, 1, "arg:address")
NATIVE_POINTEE_TAG(strncpy_from_user, 1, "user")

NATIVE_FUNCTION(strnlen_user, strnlen_user, KF_SLEEPABLE)
NATIVE_ARG(strnlen_user, 0, "arg:address")
NATIVE_POINTEE_TAG(strnlen_user, 0, "user")

NATIVE_FUNCTION(check_zeroed_user, check_zeroed_user, KF_SLEEPABLE)
NATIVE_ARG(check_zeroed_user, 0, "arg:address")
NATIVE_POINTEE_TAG(check_zeroed_user, 0, "user")

